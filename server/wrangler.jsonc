{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "formalnotes-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "notes.formalsnake.dev", "custom_domain": true }],
  "vars": {
    "BETTER_AUTH_URL": "https://notes.formalsnake.dev"
  },
  "secrets": { "required": ["BETTER_AUTH_SECRET"] },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "f21496b9e1b24ff6a79f5e14a32ef34f",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:55440/postgres"
    }
  ],
  "ratelimits": [
    {
      "name": "SIGN_IN_LIMIT",
      "namespace_id": "4301",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "SIGN_UP_LIMIT",
      "namespace_id": "4302",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "SYNC_LIMIT",
      "namespace_id": "4303",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  // Deletes expired sessions; Better Auth already refuses them.
  "triggers": { "crons": ["17 4 * * *"] },
  "observability": {
    "enabled": true,
    // Invocation logs carry request headers and the client address. Only errors the Worker logs itself remain.
    "logs": { "invocation_logs": false },
    "traces": { "enabled": true }
  }
}
